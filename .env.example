# ==============================================================================
# API Rate Limiter — Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=apiratelimiter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# Base64 or 256-bit hex secret key for signing JWT tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Service Port Bindings
BACKEND_PORT=8080
GATEWAY_PORT=8081
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Gateway & Backend URLs
BACKEND_INTERNAL_URL=http://localhost:8080
GATEWAY_INTERNAL_URL=http://localhost:8081
VITE_API_URL=http://localhost:8080
VITE_GATEWAY_URL=http://localhost:8081

# Rate Limiter Engine Behavior
# fail-open: true allows traffic when Redis is unavailable
# fail-closed: false rejects traffic with 503 or 429 when Redis is unavailable (Default: false)
RATE_LIMIT_FAIL_OPEN=false

# Grafana Admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
